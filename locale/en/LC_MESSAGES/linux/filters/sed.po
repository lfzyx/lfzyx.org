#: ../../linux/filters/sed.rst:2
msgid "sed"
msgstr "sed"

#: ../../linux/filters/sed.rst:4
msgid "stream editor，流编辑器。Sed 将来自输入的行加载到模式空间中， 使用正则表达式语法选择性地搜索和替换模式空间中的文本，然后将模式空间写入到标准输出。"
msgstr "stream editor. Sed loads lines from the input into the pattern space, selectively searches and replaces text in the pattern space using regular expression syntax, then writes the pattern space to standard output."

#: ../../linux/filters/sed.rst:8
msgid "语法"
msgstr "Syntax"

#: ../../linux/filters/sed.rst:10
msgid "sed [options] file"
msgstr "sed [options] file"

#: ../../linux/filters/sed.rst:12
msgid "将转换结果直接写入源文件中"
msgstr "write the transformed result directly back into the source file"

#: ../../linux/filters/sed.rst:14
msgid "允许一次执行多个匹配命令"
msgstr "allow multiple match commands to be executed at once"

#: ../../linux/filters/sed.rst:17
msgid "s替换命令"
msgstr "the s substitution command"

#: ../../linux/filters/sed.rst:19
msgid "s/模式/替换文字/       将每行第1个匹配“模式”的字符串转换成“替换文字”"
msgstr "s/pattern/replacement/       converts the 1st string matching \"pattern\" on each line to \"replacement\""

#: ../../linux/filters/sed.rst:21
msgid "s/模式/替换文字/2      将每行第2个匹配“模式”的字符串转换成“替换文字”"
msgstr "s/pattern/replacement/2      converts the 2nd string matching \"pattern\" on each line to \"replacement\""

#: ../../linux/filters/sed.rst:23
msgid "s/模式/替换文字/g      将每行所有匹配“模式”的字符串转换成“替换文字”"
msgstr "s/pattern/replacement/g      converts every string matching \"pattern\" on each line to \"replacement\""

#: ../../linux/filters/sed.rst:25
msgid "s/模式/替换文字/2g     将每行从第2个开始匹配“模式”的字符串转换成“替换文字”"
msgstr "s/pattern/replacement/2g     converts every string matching \"pattern\" on each line, starting from the 2nd match, to \"replacement\""

#: ../../linux/filters/sed.rst:27
msgid "3s/模式/替换文字/g     将第3行所有匹配“模式”的字符串转换成“替换文字”"
msgstr "3s/pattern/replacement/g     converts every string matching \"pattern\" on line 3 to \"replacement\""

#: ../../linux/filters/sed.rst:29
msgid "3,6s/模式/替换文字/g   将第3至6行所有匹配“模式”的字符串转换成“替换文字”"
msgstr "3,6s/pattern/replacement/g   converts every string matching \"pattern\" on lines 3 through 6 to \"replacement\""

#: ../../linux/filters/sed.rst:31
msgid "分号 ; 可以用作分隔命令执行多个匹配命令"
msgstr "a semicolon ; can be used to separate multiple match commands to execute several at once"

#: ../../linux/filters/sed.rst:33
msgid "1,3s/模式/替换文字/g; 3,$s/模式/替换文字/g  第1行到第3行所有匹配“模式”的字符串转换成“替换文字”，第3行以后所有匹配“模式”的字符串转换成“替换文字”"
msgstr "1,3s/pattern/replacement/g; 3,$s/pattern/replacement/g  converts every string matching \"pattern\" on lines 1 through 3 to \"replacement\", and every string matching \"pattern\" from line 3 onward to \"replacement\""

#: ../../linux/filters/sed.rst:36
msgid "示例"
msgstr "Example"

#: ../../linux/filters/sed.rst:38
msgid "sed -i \"s/spacename/namespace/\" .python_history"
msgstr "sed -i \"s/spacename/namespace/\" .python_history"

