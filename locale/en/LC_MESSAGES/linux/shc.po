#: ../../linux/shc.rst:15
msgid "语法"
msgstr ""

#: ../../linux/shc.rst:17
msgid "``shc ``\\ ***``[OPTION]``***\\ `` -f ``\\ ***``FILE``***\\ `` ``\\  [3]_"
msgstr ""

#: ../../linux/shc.rst:19
msgid "-e date 二进制可执行文件的过期时间，格式为 日/月/年"
msgstr ""

#: ../../linux/shc.rst:21
msgid "-m message 过期后的提示信息"
msgstr ""

#: ../../linux/shc.rst:23
msgid "-f script_name 指定要编译的shell脚本的路径及文件名"
msgstr ""

#: ../../linux/shc.rst:25
msgid "-i inline_option 内联选项"
msgstr ""

#: ../../linux/shc.rst:27
#, python-format
msgid "-x comand eXec command, as a printf format i.e: exec('%s',@ARGV)"
msgstr ""

#: ../../linux/shc.rst:29
msgid "-l last_option Last shell option i.e: --"
msgstr ""

#: ../../linux/shc.rst:31
msgid "-r 制作可再发行的二进制文件，使二进制文件能在多种相同的系统上执行"
msgstr ""

#: ../../linux/shc.rst:33
msgid "-v verbose模式，输出编译的详细情况"
msgstr ""

#: ../../linux/shc.rst:35
msgid "-D Switch on debug exec calls"
msgstr ""

#: ../../linux/shc.rst:37
msgid "-T 允许二进制文件可被追溯"
msgstr ""

#: ../../linux/shc.rst:39
msgid "-C 显示许可证"
msgstr ""

#: ../../linux/shc.rst:41
msgid "-A 显示摘要"
msgstr ""

#: ../../linux/shc.rst:43
msgid "-h 显示帮助"
msgstr ""

#: ../../linux/shc.rst:46
msgid "示例"
msgstr ""

#: ../../linux/shc.rst:48
msgid "``# shc -e 20/10/2018 -m \"lfzyx.org\" -v -T -r -f backup.sh``"
msgstr ""

#: ../../linux/shc.rst:50
msgid "运行后会生成两个文件,其中backup.sh.x是加密后的可执行二进制文件，backup.sh.x.c是c语言源文件，只需要把二进制文件传到服务器上即可。"
msgstr ""

