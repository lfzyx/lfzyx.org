#: ../../linux/tar.rst:1
msgid ""
"Unix和类Unix系统上的压缩打包工具，可以将多个文件合并为一个文件，打包后的文件名亦为“tar”。目前，tar文件格式已经成为POSIX标准，最初是POSIX.1-1988，目前是POSIX.1-2001。"
" 本程序最初的设计目的是将文件备份到磁带上(tape archive)，因而得名tar。"
msgstr ""

#: ../../linux/tar.rst:5
msgid "语法"
msgstr ""

#: ../../linux/tar.rst:7
msgid "-c，--create 创建新的tar文件"
msgstr ""

#: ../../linux/tar.rst:9
msgid "-x，--extract，--get 解开tar文件"
msgstr ""

#: ../../linux/tar.rst:11
msgid "-t，--list 列出tar文件中包含的文件的信息"
msgstr ""

#: ../../linux/tar.rst:13
msgid "-r，--append 追加新的文件到tar文件中"
msgstr ""

#: ../../linux/tar.rst:15
msgid "-u，--update 用已打包的文件的较新版本更新tar文件"
msgstr ""

#: ../../linux/tar.rst:17
msgid "-A，--catenate，--concatenate 追加 tar 文件至归档"
msgstr ""

#: ../../linux/tar.rst:19
msgid "-d，--diff，--compare 将文件系统里的文件和tar文件里的文件进行比较"
msgstr ""

#: ../../linux/tar.rst:21
msgid "--delete 删除tar文件里的文件。注意，这个功能不能用于已保存在磁带上的tar文件！"
msgstr ""

#: ../../linux/tar.rst:24
msgid ""
"-v，--verbose "
"列出每一步处理涉及的文件的信息，只用一个“v”时，仅列出文件名，使用两个“v”时，列出权限、所有者、大小、时间、文件名等信息。"
msgstr ""

#: ../../linux/tar.rst:27
msgid "-k，--keep-old-files 不覆盖文件系统上已有的文件"
msgstr ""

#: ../../linux/tar.rst:29
msgid "-f，--file [主机名:]文件名 指定要处理的文件名。可以用“-”代表标准输出或标准输入。"
msgstr ""

#: ../../linux/tar.rst:32
msgid "-P，--absolute-names 使用绝对路径"
msgstr ""

#: ../../linux/tar.rst:34
msgid "-j，--bzip2 调用bzip2执行压缩或解压缩。"
msgstr ""

#: ../../linux/tar.rst:36
msgid "-z，--gzip，--gunzip，--ungzip 调用gzip执行压缩或解压缩"
msgstr ""

#: ../../linux/tar.rst:38
msgid "-Z，--compress，--uncompress 调用compress执行压缩或解压缩"
msgstr ""

#: ../../linux/tar.rst:40
msgid "-C 指定解压缩该文件的目录"
msgstr ""

#: ../../linux/tar.rst:43
msgid "示例"
msgstr ""

#: ../../linux/tar.rst:45
msgid "``# tar xvf file.tar.xz``"
msgstr ""

#: ../../linux/tar.rst:47
msgid "解包"
msgstr ""

#: ../../linux/tar.rst:49
msgid ""
"``# tar -cvpzf test.tar.gz --exclude=/test.tar.gz --exclude=/sys "
"--exclude=/dev --exclude=/proc /``"
msgstr ""

#: ../../linux/tar.rst:51
msgid "打包整个根文件系统"
msgstr ""

