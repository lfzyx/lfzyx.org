#: ../../linux/sysstat/mpstat.rst:39
#, python-format
msgid "%usr : 显示在用户级别（例如应用程序）执行时CPU利用率的百分比"
msgstr "%usr: shows the percentage of CPU utilization spent executing at the user level (e.g. applications)"

#: ../../linux/sysstat/mpstat.rst:40
msgid "%nice :显示在拥有nice优先级的用户级别执行时CPU利用率的百分比"
msgstr "%nice: shows the percentage of CPU utilization spent executing at the user level with a nice priority"

#: ../../linux/sysstat/mpstat.rst:41
#, python-format
msgid "%sys : 现实在系统级别（例如内核）执行时CPU利用率的百分比"
msgstr "%sys: shows the percentage of CPU utilization spent executing at the system level (e.g. the kernel)"

#: ../../linux/sysstat/mpstat.rst:42
#, python-format
msgid "%iowait : 显示在系统有未完成的磁盘I/O请求期间CPU空闲时间的百分比"
msgstr "%iowait: shows the percentage of time the CPU was idle while the system had an outstanding disk I/O request"

#: ../../linux/sysstat/mpstat.rst:43
#, python-format
msgid "%irq : 显示CPU服务硬件中断所花费时间的百分比"
msgstr "%irq: shows the percentage of time the CPU spent servicing hardware interrupts"

#: ../../linux/sysstat/mpstat.rst:44
#, python-format
msgid "%soft : 显示CPU服务软件中断所花费时间的百分比"
msgstr "%soft: shows the percentage of time the CPU spent servicing software interrupts"

#: ../../linux/sysstat/mpstat.rst:45
#, python-format
msgid "%steal : 显示虚拟机管理器在服务另一个虚拟处理器时虚拟CPU处在非自愿等待下花费时间的百分比"
msgstr "%steal: shows the percentage of time a virtual CPU spent in involuntary wait while the hypervisor was servicing another virtual processor"

#: ../../linux/sysstat/mpstat.rst:46
#, python-format
msgid "%guest : 显示运行虚拟处理器时CPU花费时间的百分比"
msgstr "%guest: shows the percentage of time the CPU spent running a virtual processor"

#: ../../linux/sysstat/mpstat.rst:47
#, python-format
msgid "%idle : 显示系统没有未完成的磁盘I/O请求期间CPU空闲时间的百分比"
msgstr "%idle: shows the percentage of time the CPU was idle while the system had no outstanding disk I/O requests"

