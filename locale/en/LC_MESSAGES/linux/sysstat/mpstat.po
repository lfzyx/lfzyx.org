#: ../../linux/sysstat/mpstat.rst:16
msgid "P 指定cpu编号"
msgstr "P specifies the CPU number"

#: ../../linux/sysstat/mpstat.rst:18
msgid "3 每隔3秒打印一次报告"
msgstr "3 print a report every 3 seconds"

#: ../../linux/sysstat/mpstat.rst:20
msgid "5 一共打印5次"
msgstr "5 print 5 times in total"

#: ../../linux/sysstat/mpstat.rst:23
msgid "示例"
msgstr "Example"

#: ../../linux/sysstat/mpstat.rst:25
msgid "``mpstat -P ALL``"
msgstr "``mpstat -P ALL``"

