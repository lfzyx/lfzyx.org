#: ../../linux/multitail.rst:1
msgid "在单个shell中同时监控多个文件，算是tail的增强版"
msgstr ""

#: ../../linux/multitail.rst:4
msgid "示例"
msgstr ""

#: ../../linux/multitail.rst:6
msgid "同时监控两个文件"
msgstr ""

#: ../../linux/multitail.rst:8
msgid "``# multitail /var/log/apache2/error.log /var/log/apache2/error.log.1``"
msgstr ""

#: ../../linux/multitail.rst:10
msgid "分成两列监控两个文件"
msgstr ""

#: ../../linux/multitail.rst:12
msgid "``# multitail -s 2 /var/log/mysqld.log /var/log/xferlog``"
msgstr ""

#: ../../linux/multitail.rst:14
msgid "分成两列监控，第一列3个，第二列2个"
msgstr ""

#: ../../linux/multitail.rst:16
msgid ""
"``# multitail -s 2 -sn 3,2 /var/log/mysqld.log /var/log/xferlog "
"/var/log/yum.log /var/log/ajenti.log /var/log/xferlog``"
msgstr ""

#: ../../linux/multitail.rst:18
msgid "合并两个文件"
msgstr ""

#: ../../linux/multitail.rst:20
msgid "``# multitail /var/log/mysqld.log -I /var/log/xferlog``"
msgstr ""

#: ../../linux/multitail.rst:22
msgid "合并两个文件并且区分颜色"
msgstr ""

#: ../../linux/multitail.rst:24
msgid ""
"``# multitail -ci green /var/log/yum.log -ci yellow -I "
"/var/log/mysqld.log``"
msgstr ""

#: ../../linux/multitail.rst:26
msgid "监控文件的同时执行命令"
msgstr ""

#: ../../linux/multitail.rst:28
msgid "``# multitail log/josei.access.log  -l \"ping lfzyx.org\"``"
msgstr ""

#: ../../linux/multitail.rst:30
msgid "过滤内容"
msgstr ""

#: ../../linux/multitail.rst:32
msgid "``# multitail -e \"Opera/9.80\" log/access.log ``"
msgstr ""

#: ../../linux/multitail.rst:34
msgid "反选过滤内容"
msgstr ""

#: ../../linux/multitail.rst:36
msgid "``# #multitail -v -e“ssh”/var/log/messages``"
msgstr ""

