msgstr "RAM - minimum 1GB, 2GB recommended"

#: ../../devops/gocd.rst:25
msgid "CPU - minimum 2 cores, 2GHz"
msgstr "CPU - minimum 2 cores, 2GHz"

#: ../../devops/gocd.rst:26
msgid "Disk - minimum 1GB free space"
msgstr "Disk - minimum 1GB free space"

#: ../../devops/gocd.rst:27 ../../devops/gocd.rst:56
msgid "env - Java Runtime Environment (JRE) version 8"
msgstr "env - Java Runtime Environment (JRE) version 8"

