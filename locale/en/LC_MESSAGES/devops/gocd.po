msgid "GoCD Agents"
msgstr "GoCD Agents"

#: ../../devops/gocd.rst:54
msgid "RAM - minimum 128MB, 256MB recommended"
msgstr "RAM - minimum 128MB, 256MB recommended"

#: ../../devops/gocd.rst:55
msgid "CPU - minimum 2GHz"
msgstr "CPU - minimum 2GHz"

