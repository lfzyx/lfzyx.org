msgid "语法 [#]_"
msgstr "Syntax"

#: ../../python/asyncio.rst:56
msgid "async def 用于定义协程的关键字"
msgstr "async def — keyword used to define a coroutine"

#: ../../python/asyncio.rst:58
msgid "await 挂起阻塞的异步调用接口"
msgstr "await — suspends a blocking asynchronous call interface"

#: ../../python/asyncio.rst:60
msgid "asyncio.get_event_loop 创建一个默认的事件循环"
msgstr "asyncio.get_event_loop — creates a default event loop"

#: ../../python/asyncio.rst:62
msgid "asyncio.gather 接受一堆协程"
msgstr "asyncio.gather — accepts a bunch of coroutines"

#: ../../python/asyncio.rst:64
msgid "asyncio.wait 接受一个协程组成的列表"
msgstr "asyncio.wait — accepts a list made up of coroutines"

